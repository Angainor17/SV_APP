# Скопируй в scripts/rustore.env (файл в .gitignore) и заполни реальными значениями.
# Использование:  source scripts/rustore.env && ./scripts/publish-rustore.sh
#
# Ничего из этого НЕ должно попадать в git.

# --- RuStore API (консоль → «API RuStore» → ключ) ---
export RUSTORE_KEY_ID=               # числовой ID ключа (не название)
export RUSTORE_PRIVATE_KEY=          # приватный ключ (base64) или PEM-текст

# --- Что публикуем ---
export RUSTORE_PACKAGE=su.sv.app
export RUSTORE_PUBLISH_TYPE=MANUAL   # MANUAL | INSTANTLY | DELAYED
export RUSTORE_WHATS_NEW='Что нового в этой версии'

# --- (опц.) Переиспользовать уже созданный черновик ---
#export RUSTORE_VERSION_ID=

# --- (опц.) Подпись AAB здесь (если не настроен signingConfig в Gradle) ---
#export SIGN_STORE=/path/to/sv.jks
#export SIGN_ALIAS=
#export SIGN_STORE_PASS=
#export SIGN_KEY_PASS=

# --- (опц.) Загрузить готовый артефакт, не пересобирая ---
#export RUSTORE_ARTIFACT=app/build/outputs/bundle/release/app-release.aab
