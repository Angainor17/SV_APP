<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash Screen для Android 12+ (API 31+) -->
    <style name="Theme.SVAPP" parent="Theme.AppCompat.NoActionBar">
        <!-- Материал3 цвета будут установлены через Compose SVAPPTheme -->
        <!-- Splash Screen для Android 12+ -->
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <!-- Иконка splash screen (светлая/тёмная через drawable/drawable-night) -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>